if SOC_SILABS_XG29

config NUM_IRQS
	# must be >= the highest interrupt number used
	default 70

config PM
	default n
	select UART_INTERRUPT_DRIVEN if SERIAL_SUPPORT_INTERRUPT

choice PM_POLICY
	default PM_POLICY_DEFAULT
	depends on PM
endchoice

# Use PSA Crypto Driver and wrapper from hal_silabs
configdefault MBEDTLS_PSA_CRYPTO_BUILTIN_DRIVER_WRAPPER
	default n

endif

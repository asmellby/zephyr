/*
 * VDAC0 channel 0 drives PC0 through the analog bus (auxiliary output, CDEVEN0), and IADC0 reads
 * the same pad through the other even line of the bus (CDEVEN1). No external wiring is needed.
 */

#include <zephyr/dt-bindings/adc/silabs-adc.h>
#include <zephyr/dt-bindings/dac/silabs-vdac.h>
#include <zephyr/dt-bindings/pinctrl/silabs/xg24-pinctrl.h>

/ {
	zephyr,user {
		io-channels = <&vdac0 0>, <&adc0 0>;
		io-channel-names = "dac", "adc";
	};
};

&pinctrl {
	vdac0_abus: vdac0_abus {
		group0 {
			silabs,analog-bus = <ABUS_CDEVEN0_VDAC0CH0>;
		};
	};

	adc0_abus: adc0_abus {
		group0 {
			silabs,analog-bus = <ABUS_CDEVEN1_IADC0>;
		};
	};
};

&adc0 {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&adc0_abus>;
	pinctrl-names = "default";
	status = "okay";

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
		zephyr,input-positive = <IADC_INPUT_PC0>;
	};
};

&vdac0 {
	pinctrl-0 = <&vdac0_abus>;
	pinctrl-names = "default";
	status = "okay";
	voltage-reference = "AVDD";

	channel@0 {
		reg = <0>;
		aux-output = <VDAC_OUTPUT_PC0>;
		zephyr,resolution = <12>;
	};
};

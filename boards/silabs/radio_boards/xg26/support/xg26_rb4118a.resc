# SPDX-License-Identifier: Apache-2.0

:name: xG26-RB4118A
:description: This script is prepared to run Zephyr on the xG26-RB4118A radio board.

$name?="xg26_rb4118a"

# Radio timing (BLE T_IFS, 802.15.4 ACK turnaround) and the handshakes between
# the main CPU and the radio sequencer CPU need a quantum well below the
# 100 us default.
emulation SetGlobalQuantum "0.00002"

mach create $name
machine LoadPlatformDescription @platforms/boards/silabs/brd4118a.repl
machine LoadPlatformDescription $ORIGIN/xg26_rb4118a-exp-loopback.repl

# MX25R8035F on EUSART1: MOSI PC2, MISO PC1, SCLK PC3, CS PC4
sysbus.gpioPort AttachSpiDevice sysbus.eusart1.mx25r80 34 33 35 36

# The core runs from HFRCODPLL at 78 MHz.
cpu PerformanceInMips 78

# The console is the board controller's virtual COM port on PA08/PA09, whichever USART or EUSART
# the firmware routes there
showAnalyzer sysbus.gpioPort.vcom

# Load the image once: a reset keeps flash and RAM contents, as on hardware.
# Reloading the ELF on reset would zero .noinit through its memory-only segments.
sysbus LoadELF $elf

macro reset
"""
    cpu VectorTableOffset `sysbus GetSymbolAddress "_vector_table"`
"""
runMacro $reset
